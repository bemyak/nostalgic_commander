{
  "name": "tuiface",
  "author": "Elizardbeth",
  "version": "1.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.3"
  },
  "pebble": {
    "displayName": "tuiface",
    "uuid": "a4bfc6a1-5c48-431f-b996-03b83f2ca653",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [
      "location",
      "health",
      "configurable"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "WEATHER_TEMP",
      "WEATHER_COND",
      "SETTINGS_THEME",
      "SETTINGS_UNITS",
      "SETTINGS_DATE_FORMAT",
      "SETTINGS_SHORT_DATE_FORMAT",
      "SETTINGS_DOW_POSITION",
      "SLOT_1",
      "SLOT_2",
      "SLOT_3",
      "SLOT_4",
      "SLOT_5",
      "SLOT_6",
      "WEATHER_AQI",
      "WEATHER_UV"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_VGA_16",
          "file": "fonts/Px437_IBM_VGA_8x16.ttf",
          "characterRegex": "[\\x20-\\x7E\u2588\u2591]",
          "size": 16
        },
        {
          "type": "font",
          "name": "FONT_VGA_64",
          "file": "fonts/Px437_IBM_VGA_8x16.ttf",
          "characterRegex": "[\\x20-\\x7E]",
          "size": 64
        }
      ]
    }
  }
}
